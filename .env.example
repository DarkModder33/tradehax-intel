# yahoo (default) loads Yahoo Finance chart data in the browser through the
# keyless cors.dev proxy. mock forces the simulated feed. The dashboard always
# labels demo data as demo data. This value is public; do not put secrets here.
NEXT_PUBLIC_MARKET_DATA_PROVIDER=yahoo

# Site prefix. Unset or /tradehax-intel matches the GitHub project site. Empty is the domain root (tradehaxai.tech).
# NEXT_PUBLIC_BASE_PATH=/tradehax-intel

# Public origin of the flow worker. The default is the Heroku app. Set to off to hide live panels.
# NEXT_PUBLIC_WORKER_URL=https://tradehax-intel-worker-bf2f623ce81a.herokuapp.com

# Unused in v1. A later provider can read these without changing the UI.
# POLYGON_API_KEY=
# FINNHUB_API_KEY=
# TRADIER_API_KEY=
