# yahoo (default) loads Yahoo Finance chart data in the browser through the
# keyless cors.dev proxy. mock forces the simulated feed. The dashboard always
# labels demo data as demo data. This value is public; do not put secrets here.
NEXT_PUBLIC_MARKET_DATA_PROVIDER=yahoo

# Site prefix. Unset serves https://tradehaxai.tech from /. Set a path only for a project-site mount.
# NEXT_PUBLIC_BASE_PATH=

# Public origin of the flow worker. The default is the Heroku app. Set to off to hide live panels.
# NEXT_PUBLIC_WORKER_URL=https://tradehax-intel-worker-bf2f623ce81a.herokuapp.com

# Unused in v1. A later provider can read these without changing the UI.
# POLYGON_API_KEY=
# FINNHUB_API_KEY=
# TRADIER_API_KEY=

# Social posting runs in GitHub Actions, not in the browser. Leave these empty locally.
# SOCIAL_AUTOPOST defaults to 1 in the data workflow. SOCIAL_DRYRUN=1 logs instead of posting.
# Each adapter runs only when its secrets exist. Bluesky and Mastodon are stubbed.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# SOCIAL_DRYRUN=1
